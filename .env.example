DATABASE_URL=postgres://fmarch:fmarch@localhost:5544/fmarch
FMARCH_EVENT_WRAP_KEY=replace-with-canonical-padded-base64-32-byte-key-or-debug-passphrase
FMARCH_EVENT_WRAP_KID=local-dev
# Bounded historical ring used only while an online rotation is in progress:
# FMARCH_EVENT_WRAP_KEYS=prior-kid=prior-key
FMARCH_EVENT_ARCHIVE_KEY=replace-with-a-distinct-canonical-padded-base64-32-byte-key-or-debug-passphrase
FMARCH_EVENT_ARCHIVE_KID=local-dev-archive
# Every serving process requires this keyed blind-index secret and public KID.
# Debug/test library calls may use a deterministic fallback only when neither
# is configured; normal server startup still rejects absent or placeholder data.
FMARCH_PROFILE_HANDLE_INDEX_KEY=replace-with-at-least-32-random-bytes
FMARCH_PROFILE_HANDLE_INDEX_KID=local-dev-profile-index
# Rotation is a drained maintenance cut. Supply the replacement only to
# `fmarch-profile-index-admin`, never to the normal API process; see
# docs/ops/profile-handle-index-rotation.md.
# FMARCH_PROFILE_HANDLE_INDEX_REPLACEMENT_KEY=replace-with-next-at-least-32-random-bytes
# Debug/test-only subject authority. Release/server deployments use the
# dedicated object authority variables shown in deploy/railway/api.env.example.
FMARCH_SUBJECT_KEY_DIR=target/subject-keys
FMARCH_AUTH_SOURCE_SIGNING_KEY=replace-with-at-least-32-random-bytes
# Explicit local-only identity proof mode. Remove this and configure all three
# API WorkOS variables for any shared or hosted environment.
FMARCH_DEV_AUTH=1
# WORKOS_CLIENT_ID=client_replace_me
# WORKOS_ISSUER=https://api.workos.com/user_management/client_replace_me
# WORKOS_JWKS_URL=https://api.workos.com/sso/jwks/client_replace_me
# FMARCH_IDENTITY_DELIVERY_ENDPOINT=https://provider.example.test/v1/deliveries
# FMARCH_IDENTITY_DELIVERY_PROVIDER_ID=http-json
# FMARCH_IDENTITY_DELIVERY_AUTH_TOKEN=load-from-your-secret-manager
