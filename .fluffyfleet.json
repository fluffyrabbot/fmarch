{
  "schemaVersion": 1,
  "profiles": {
    "linux": {
      "environment": {
        "FMARCH_EXTERNAL_BUILD_ROOT": "${FLEET_CACHE_ROOT}/fmarch-canonical-v1",
        "FMARCH_PROOF_TOOLCHAIN_ROOT": "${FLEET_CACHE_ROOT}/fmarch-toolchain",
        "CARGO_BUILD_JOBS": "2"
      },
      "writableDirectories": [
        "${FLEET_CACHE_ROOT}/fmarch-canonical-v1",
        "${FLEET_CACHE_ROOT}/fmarch-toolchain"
      ],
      "fingerprint": [
        "node --version",
        "npm --version",
        "python3 --version"
      ],
      "setup": [
        "bash scripts/check-build-posture.sh --apply",
        "bash scripts/provision-linux-proof.sh",
        "npm ci --no-audit --no-fund",
        "npm ci --prefix frontend --no-audit --no-fund",
        "npm exec -- playwright install chromium",
        "node tools/frontend_cross_browser.mjs --provision"
      ],
      "verify": [
        "bash scripts/linux-proof.sh --mode full --jobs 2 --keep-going"
      ],
      "resourceClass": "heavy",
      "stepTimeoutMs": 14400000,
      "verificationModes": {
        "push": [
          "bash scripts/linux-proof.sh --mode push --base \"$FLEET_COMPARISON_SHA\" --jobs 2 --keep-going"
        ],
        "sprint": [
          "bash scripts/linux-proof.sh --mode sprint --base \"$FLEET_COMPARISON_SHA\" --jobs 2 --keep-going"
        ],
        "audit": [
          "bash scripts/linux-proof.sh --mode full --force --jobs 2 --keep-going"
        ]
      }
    }
  }
}
