FROM node:24-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205 AS builder

ARG FMARCH_RELEASE_COMMIT=development
ENV FMARCH_RELEASE_COMMIT=${FMARCH_RELEASE_COMMIT}

WORKDIR /app/frontend

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --ignore-scripts

WORKDIR /app
COPY . .

WORKDIR /app/frontend
RUN npm run build \
    && npm prune --omit=dev

FROM node:24-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205 AS runtime

ARG FMARCH_RELEASE_COMMIT=development

LABEL org.opencontainers.image.source="https://github.com/fluffyrabbot/fmarch" \
      org.opencontainers.image.title="fmarch-frontend" \
      org.opencontainers.image.revision="${FMARCH_RELEASE_COMMIT}"

WORKDIR /app
ENV NODE_ENV=production
ENV FMARCH_RELEASE_COMMIT=${FMARCH_RELEASE_COMMIT}

COPY --from=builder /app/frontend/build ./build
COPY --from=builder /app/frontend/node_modules ./node_modules

USER node

EXPOSE 3000

CMD ["node", "build"]
