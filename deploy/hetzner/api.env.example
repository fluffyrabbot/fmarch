# Hetzner API container environment (Kamal secrets and env). Values come
# from `tofu output` in infra/environments/<env> and ~/secure/fmarch/<env>;
# never commit a filled-in copy.
# DATABASE_URL uses the fmarch_application login over the private network and
# verifies the server against the environment's private PostgreSQL CA, which
# Kamal mounts read-only at the sslrootcert path. Do not set PG* variables.
DATABASE_URL=postgres://fmarch_application:<application-password>@10.40.1.21:5432/fmarch?sslmode=verify-full&sslrootcert=/etc/fmarch/pg-tls/ca.crt
# Canonical database target identity (RFC D12): `tofu output` database_authority.instance_id.
FMARCH_DATABASE_ENVIRONMENT=staging
FMARCH_DATABASE_INSTANCE_ID=<database-instance-uuid>
# FMARCH_RELEASE_ACCEPTANCE_KEY_SHA256 is staging-only and never set by hand:
# the release script deploys the SHA-256 of its private release acceptance
# key with every staging release. The API refuses it outside the staging
# database identity, and production variable authority rejects it.
# Shared B2 media bucket (`tofu output` buckets.media and bucket_writer_keys.api-media).
AWS_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
AWS_ACCESS_KEY_ID=<api-media key id>
AWS_SECRET_ACCESS_KEY=<api-media key secret>
AWS_S3_BUCKET_NAME=<prefix>-staging-media
AWS_DEFAULT_REGION=us-west-004
AWS_S3_URL_STYLE=path
FMARCH_OBJECT_STORAGE_CREDENTIAL_KID=staging-YYYY-MM-DD
# Runtime KEKs wrap random per-stream data keys; rotation rewraps only the
# stream-key table. Archive custody is independent so exports never carry a
# runtime key or plaintext stream key.
FMARCH_EVENT_WRAP_KID=staging-wrap-v1
FMARCH_EVENT_WRAP_KEY=<required-canonical-padded-base64-32-byte-secret>
# Set only during a bounded rotation, then remove after the admin rehearsal and
# immutable retirement complete: prior-kid=prior-canonical-base64-key
# FMARCH_EVENT_WRAP_KEYS=
FMARCH_EVENT_ARCHIVE_KID=staging-archive-v1
FMARCH_EVENT_ARCHIVE_KEY=<required-distinct-canonical-padded-base64-32-byte-secret>
# Keyed blind index for active profile-handle uniqueness. It must be an
# environment-local opaque secret of at least 32 bytes. Startup audits every
# active reservation against this configuration before the API becomes ready.
# Rotate only through the drained `fmarch-profile-index-admin` workflow in
# docs/ops/profile-handle-index-rotation.md. Do not make an ad-hoc service-var
# flip, and never set the one-shot replacement key on the API service.
FMARCH_PROFILE_HANDLE_INDEX_KEY=<required-at-least-32-byte-opaque-secret>
FMARCH_PROFILE_HANDLE_INDEX_KID=staging-YYYY-MM-DD
# Subject authority (RFC D6, D7). The manifest and revocation journal live in
# the long-locked subject-journal bucket under a credential that cannot delete;
# wrapped subject keys live in subject-keys under a credential that can, because
# deleting a key object is how erasure crypto-shreds a subject. Bootstrap the
# manifest once with `fmarch-server --bootstrap-subject-authority`.
FMARCH_SUBJECT_AUTHORITY_ENDPOINT=https://s3.us-west-004.backblazeb2.com
FMARCH_SUBJECT_AUTHORITY_REGION=us-west-004
FMARCH_SUBJECT_AUTHORITY_URL_STYLE=path
FMARCH_SUBJECT_JOURNAL_BUCKET=<prefix>-staging-subject-journal
FMARCH_SUBJECT_JOURNAL_ACCESS_KEY_ID=<api-subject-journal key id>
FMARCH_SUBJECT_JOURNAL_SECRET_ACCESS_KEY=<api-subject-journal key secret>
FMARCH_SUBJECT_KEYS_BUCKET=<prefix>-staging-subject-keys
FMARCH_SUBJECT_KEYS_ACCESS_KEY_ID=<api-subject-keys key id>
FMARCH_SUBJECT_KEYS_SECRET_ACCESS_KEY=<api-subject-keys key secret>
# Immutable random genesis identifier recorded in the bucket manifest and DB binding.
FMARCH_SUBJECT_AUTHORITY_ID=<required-random-uuid>
FMARCH_SUBJECT_KEY_AUTHORITY_REVISION=staging-YYYY-MM-DD
FMARCH_SUBJECT_AUTHORITY_WRAP_KID=staging-wrap-YYYY-MM-DD
# The wrapping key itself is never configured in plaintext. The API unwraps it
# once at startup through KMS: ciphertext from infra/scripts/wrap-authority-key.sh,
# `tofu output` kms_key_arn and kms_decrypt_credential. The IAM policy accepts
# only Decrypt from this environment's app hosts with the matching context.
FMARCH_SUBJECT_AUTHORITY_ENVIRONMENT=staging
FMARCH_SUBJECT_AUTHORITY_KMS_KEY_ARN=arn:aws:kms:us-east-1:<account>:key/<key-id>
FMARCH_SUBJECT_AUTHORITY_WRAP_KEY_CIPHERTEXT=<contents of ~/secure/fmarch/staging/subject-authority-wrap.kms>
FMARCH_SUBJECT_AUTHORITY_KMS_ACCESS_KEY_ID=<kms_decrypt_credential access key id>
FMARCH_SUBJECT_AUTHORITY_KMS_SECRET_ACCESS_KEY=<kms_decrypt_credential secret>
FMARCH_SUBJECT_AUTHORITY_JOURNAL_KID=staging-journal-YYYY-MM-DD
FMARCH_SUBJECT_AUTHORITY_JOURNAL_KEY=<required-secret-32-byte-base64>
FMARCH_AUTH_SOURCE_SIGNING_KEY=<shared with the frontend>
FMARCH_AUTH_SOURCE_SIGNING_KID=staging-YYYY-MM-DD
RUST_LOG=info
# WorkOS JWT verification. Replace the client placeholder in all three values,
# then run `npm run preflight:workos-oidc` with them exported. The preflight
# requires the issuer and JWKS URL to exactly match client-scoped OIDC discovery.
# The API deliberately has no WorkOS API key.
WORKOS_CLIENT_ID=client_replace_me
FMARCH_WORKOS_CREDENTIAL_KID=staging-YYYY-MM-DD
WORKOS_ISSUER=https://api.workos.com/user_management/client_replace_me
WORKOS_JWKS_URL=https://api.workos.com/sso/jwks/client_replace_me
# Hosted default: WorkOS owns sign-in. Identity delivery is an independent
# application transport required for community invitations and recovery flows.
FMARCH_CLASSIC_AUTH=0
# Fresh-database root of authority. Set the WorkOS user id for the first deploy.
# Startup binds it to one local principal and grants the first GlobalAdmin only
# while no active GlobalAdmin exists. Remove this after the first successful boot.
# FMARCH_BOOTSTRAP_ADMIN_WORKOS_USER_ID=user_replace_me
# FMARCH_BOOTSTRAP_ADMIN_LABEL=admin@example.com
# kamal-proxy forwards to this port; the server binds [::]:$PORT.
PORT=8080
# Capacity defaults. Tune only from hosted measurements; keep queues bounded.
FMARCH_DB_MAX_CONNECTIONS=10
FMARCH_DB_ACQUIRE_TIMEOUT_MS=250
FMARCH_DB_STATEMENT_TIMEOUT_MS=5000
FMARCH_DB_LOCK_TIMEOUT_MS=1000
FMARCH_DB_IDLE_TRANSACTION_TIMEOUT_MS=10000
FMARCH_HTTP_MAX_IN_FLIGHT=128
FMARCH_HTTP_QUEUE_TIMEOUT_MS=50
FMARCH_HTTP_REQUEST_TIMEOUT_MS=40000
FMARCH_HTTP_RETRY_AFTER_SECONDS=1
FMARCH_WS_MAX_CONNECTIONS=512
FMARCH_WS_MAX_CONNECTIONS_PER_PRINCIPAL=4
FMARCH_PASSWORD_MAX_IN_FLIGHT=4
FMARCH_MEDIA_MAX_IN_FLIGHT=2
FMARCH_MEDIA_ACCOUNT_QUOTA_BYTES=268435456
FMARCH_MEDIA_UPLOAD_LEASE_SECONDS=900
FMARCH_MEDIA_READ_MAX_IN_FLIGHT=16
FMARCH_MEDIA_READ_MAX_IN_FLIGHT_BYTES=67108864
FMARCH_LIVE_PROJECTION_CAPACITY=256
FMARCH_SUBJECT_ERASURE_IDLE_INTERVAL_MS=5000
FMARCH_SUBJECT_ERASURE_ERROR_BACKOFF_MS=1000
FMARCH_MEDIA_RECONCILIATION_INTERVAL_MS=5000
FMARCH_MEDIA_RECONCILIATION_TIMEOUT_MS=2000
FMARCH_MEDIA_RECONCILIATION_BATCH_SIZE=1
FMARCH_WORKER_RESTART_BACKOFF_MS=1000
FMARCH_WORKER_RESTART_LIMIT=3
FMARCH_WORKER_READINESS_GRACE_MS=10000
FMARCH_WORKER_HEARTBEAT_STALE_MS=30000
FMARCH_SHUTDOWN_DRAIN_TIMEOUT_MS=45000
# The image runs as UID 10001 and has no writable media volume; all media is shared object state.
# Required hosted identity delivery transport, independent of whether sign-in is
# WorkOS-only or classic-plus-WorkOS. The generation id names this exact staging
# endpoint/protocol and must never be reused after either changes. Production
# uses its own distinct, versioned generation id and authentication token. A
# token-only rotation requires old/new overlap through full replica drain;
# otherwise select a fresh generation before revoking the old credential.
# The provider must enforce the earlier effect deadline. The margin must cover
# the maximum database-clock lead over its clock plus its maximum
# deadline-to-no-effect quiescence lag; an atomic final check/effect has zero
# quiescence lag. The claim lease also reserves one second for DB clock flooring.
# Staging mails through the resend adapter: it posts each credential to
# Resend's /emails API under a per-delivery idempotency key, and its probe
# proves the key with a deliberately invalid request. The token is a
# sending-only Resend API key; the sender must be on a Resend-verified domain
# (without one, Resend delivers only to the Resend account's own address), and
# links must use this environment's canonical frontend origin. Changing the
# sender or link origin changes the configuration fingerprint.
FMARCH_IDENTITY_DELIVERY_ADAPTER=resend
FMARCH_IDENTITY_DELIVERY_ENDPOINT=https://api.resend.com/emails
FMARCH_IDENTITY_DELIVERY_PROVIDER_ID=staging-mail-v1
FMARCH_IDENTITY_DELIVERY_AUTH_TOKEN=<sending-only Resend API key>
FMARCH_IDENTITY_DELIVERY_SENDER=fmarch staging <invites@verified-domain.invalid>
FMARCH_IDENTITY_DELIVERY_LINK_ORIGIN=https://staging.<domain>/
# FMARCH_IDENTITY_DELIVERY_CONNECT_TIMEOUT_MS=1000
# FMARCH_IDENTITY_DELIVERY_RESPONSE_TIMEOUT_MS=3000
# FMARCH_IDENTITY_DELIVERY_BODY_TIMEOUT_MS=1000
# FMARCH_IDENTITY_DELIVERY_TOTAL_TIMEOUT_MS=5000
# FMARCH_IDENTITY_DELIVERY_MAX_RESPONSE_BYTES=65536
# FMARCH_IDENTITY_DELIVERY_MAX_CONCURRENCY=4
# FMARCH_IDENTITY_DELIVERY_POLL_INTERVAL_MS=100
# FMARCH_IDENTITY_DELIVERY_CLAIM_LEASE_MS=40000
# FMARCH_IDENTITY_DELIVERY_PROVIDER_CLOCK_SKEW_MARGIN_MS=5000
# FMARCH_IDENTITY_DELIVERY_PROVIDER_TIMEOUT_MS=10000
# FMARCH_IDENTITY_DELIVERY_DATABASE_TIMEOUT_MS=6000
# FMARCH_IDENTITY_DELIVERY_RETRY_BASE_SECONDS=2
# FMARCH_IDENTITY_DELIVERY_RETRY_MAX_SECONDS=300
# FMARCH_IDENTITY_DELIVERY_MAX_ATTEMPTS=8
