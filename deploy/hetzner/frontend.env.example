# Hetzner frontend container environment (Kamal secrets and env). Production
# uses <domain> / api.<domain> and an isolated WorkOS application.
ORIGIN=https://staging.<domain>
# WorkOS AuthKit server configuration. Keep the API key and cookie password in
# Kamal secrets. WORKOS_REDIRECT_URI must exactly match the dashboard redirect.
WORKOS_CLIENT_ID=client_replace_me
WORKOS_API_KEY=<WorkOS API key>
WORKOS_REDIRECT_URI=https://staging.<domain>/auth/callback
WORKOS_COOKIE_PASSWORD=<at least 32 random characters>
FMARCH_WORKOS_CREDENTIAL_KID=staging-YYYY-MM-DD
# Public API base: used for URLs handed to the browser (live websocket).
FMARCH_API_BASE_URL=https://api-staging.<domain>
# Private load balancer for SSR fetches (RFC D15; `tofu output` internal_api_url).
# The frontend sends app-session and one-time WorkOS bearers here, so it accepts
# only a plain-HTTP RFC 1918 IPv4 address that never leaves the private network.
FMARCH_API_INTERNAL_URL=http://10.40.1.6
# Shared only with the API; signs edge-derived client source attribution.
FMARCH_AUTH_SOURCE_SIGNING_KEY=<shared with the API>
FMARCH_AUTH_SOURCE_SIGNING_KID=staging-YYYY-MM-DD
# Per-fetch SSR budget in ms (0 disables). Cold loads fall back to fixture
# payloads when the API exceeds it.
# FMARCH_SSR_FETCH_TIMEOUT_MS=2000
# Local principal/capability resolution cache TTL in ms (0 disables).
# FMARCH_SESSION_CACHE_TTL_MS=30000
