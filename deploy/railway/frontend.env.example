# Railway staging frontend variables. Production uses the corresponding
# canonical production domains and an isolated WorkOS application.
ORIGIN=https://fmarch-frontend-staging.up.railway.app
# WorkOS AuthKit server configuration. Keep the API key and cookie password in
# Railway secrets. WORKOS_REDIRECT_URI must exactly match the dashboard redirect.
WORKOS_CLIENT_ID=client_replace_me
WORKOS_API_KEY=${{WORKOS_API_KEY}}
WORKOS_REDIRECT_URI=https://fmarch-frontend-staging.up.railway.app/auth/callback
WORKOS_COOKIE_PASSWORD=${{WORKOS_COOKIE_PASSWORD}}
FMARCH_WORKOS_CREDENTIAL_KID=staging-YYYY-MM-DD
# Public API base: used for URLs handed to the browser (live websocket).
FMARCH_API_BASE_URL=https://fmarch-staging.up.railway.app
# Private-network API base for SSR fetches. Keep this exact authority: the
# frontend sends app-session and one-time WorkOS bearers here, and production
# promotion rejects alternate hosts, schemes, or ports. Railway scopes the
# `fmarch` private DNS name to the selected environment and reaches it over IPv6.
FMARCH_API_INTERNAL_URL=http://fmarch.railway.internal:8080
# Shared only with the API; signs edge-derived client source attribution.
FMARCH_AUTH_SOURCE_SIGNING_KEY=${{FMARCH_AUTH_SOURCE_SIGNING_KEY}}
FMARCH_AUTH_SOURCE_SIGNING_KID=staging-YYYY-MM-DD
# Per-fetch SSR budget in ms (0 disables). Cold loads fall back to fixture
# payloads when the API exceeds it.
# FMARCH_SSR_FETCH_TIMEOUT_MS=2000
# Local principal/capability resolution cache TTL in ms (0 disables).
# FMARCH_SESSION_CACHE_TTL_MS=30000
