# Railway migrator service variables. This is the only hosted process that
# receives the schema-owner URL or either role-bootstrap password.
# Railway's base Postgres URL has no query options; append exactly one explicit
# TLS-protecting mode. Promotion also accepts verify-ca or verify-full.
# Do not set PG* connection variables; this URL is the sole connection authority.
DATABASE_MIGRATION_URL=${{Postgres.DATABASE_URL}}?sslmode=require
FMARCH_DATABASE_ENVIRONMENT=staging
FMARCH_DATABASE_PROJECT_ID=9d285d67-c11b-4508-9efb-fad042787b4c
FMARCH_DATABASE_ENVIRONMENT_ID=e109e500-2a4c-48a3-96f2-e92a9edb63e4
FMARCH_DATABASE_APPLICATION_PASSWORD=<required-random-uri-safe-secret-at-least-32-characters>
FMARCH_DATABASE_KEY_ADMIN_PASSWORD=<required-distinct-random-uri-safe-secret-at-least-32-characters>
FMARCH_DATABASE_AUTHORITY_REVISION=staging-YYYY-MM-DD
RUST_LOG=info

# Never add DATABASE_URL, DATABASE_KEY_ADMIN_URL, event KEKs, object-storage
# credentials, identity credentials, or public networking to this one-shot
# service. It exits after migrations, ACL reconciliation, and schema proof.
