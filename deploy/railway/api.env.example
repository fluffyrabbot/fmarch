# Railway API service variables. Set these in Railway, never in the repository.
# DATABASE_URL should be a Railway reference variable to the project Postgres service.
DATABASE_URL=${{Postgres.DATABASE_URL}}
# Shared Railway Bucket. Both API replicas must receive the same references.
AWS_ENDPOINT_URL=${{media.ENDPOINT}}
AWS_ACCESS_KEY_ID=${{media.ACCESS_KEY_ID}}
AWS_SECRET_ACCESS_KEY=${{media.SECRET_ACCESS_KEY}}
AWS_S3_BUCKET_NAME=${{media.BUCKET}}
AWS_DEFAULT_REGION=${{media.REGION}}
AWS_S3_URL_STYLE=virtual-host
FMARCH_OBJECT_STORAGE_CREDENTIAL_KID=staging-YYYY-MM-DD
FMARCH_EVENT_ENCRYPTION_KID=railway-v1
# Set this to a secret 32-byte base64 value in each isolated environment.
FMARCH_EVENT_ENCRYPTION_KEY=<required-canonical-padded-base64-32-byte-secret>
# Dedicated Railway Bucket for the erasure authority. This must not be the media
# bucket and staging/production must never share it. Bootstrap its immutable
# manifest once with `fmarch-server --bootstrap-subject-authority` before normal startup.
FMARCH_SUBJECT_AUTHORITY_ENDPOINT=${{subject-authority.ENDPOINT}}
FMARCH_SUBJECT_AUTHORITY_ACCESS_KEY_ID=${{subject-authority.ACCESS_KEY_ID}}
FMARCH_SUBJECT_AUTHORITY_SECRET_ACCESS_KEY=${{subject-authority.SECRET_ACCESS_KEY}}
FMARCH_SUBJECT_AUTHORITY_BUCKET=${{subject-authority.BUCKET}}
FMARCH_SUBJECT_AUTHORITY_REGION=${{subject-authority.REGION}}
FMARCH_SUBJECT_AUTHORITY_URL_STYLE=virtual-host
# Immutable random genesis identifier recorded in the bucket manifest and DB binding.
FMARCH_SUBJECT_AUTHORITY_ID=<required-random-uuid>
FMARCH_SUBJECT_KEY_AUTHORITY_REVISION=staging-YYYY-MM-DD
FMARCH_SUBJECT_AUTHORITY_WRAP_KID=staging-wrap-YYYY-MM-DD
FMARCH_SUBJECT_AUTHORITY_WRAP_KEY=<required-secret-32-byte-base64>
FMARCH_SUBJECT_AUTHORITY_JOURNAL_KID=staging-journal-YYYY-MM-DD
FMARCH_SUBJECT_AUTHORITY_JOURNAL_KEY=<required-secret-32-byte-base64>
FMARCH_AUTH_SOURCE_SIGNING_KEY=${{FMARCH_AUTH_SOURCE_SIGNING_KEY}}
FMARCH_AUTH_SOURCE_SIGNING_KID=staging-YYYY-MM-DD
RUST_LOG=info
# WorkOS JWT verification. Copy the issuer and JWKS URL shown for this AuthKit
# environment; the API deliberately has no WorkOS API key.
WORKOS_CLIENT_ID=client_replace_me
FMARCH_WORKOS_CREDENTIAL_KID=staging-YYYY-MM-DD
WORKOS_ISSUER=https://api.workos.com/
WORKOS_JWKS_URL=https://api.workos.com/sso/jwks/client_replace_me
# Hosted default: WorkOS owns identity delivery. Classic authentication may be
# enabled only together with the real provider variables near the end of this file.
FMARCH_CLASSIC_AUTH=0
# Fresh-database root of authority. Set the WorkOS user id for the first deploy.
# Startup binds it to one local principal and grants the first GlobalAdmin only
# while no active GlobalAdmin exists. Remove this after the first successful boot.
# FMARCH_BOOTSTRAP_ADMIN_WORKOS_USER_ID=user_replace_me
# FMARCH_BOOTSTRAP_ADMIN_LABEL=admin@example.com
# Railway supplies PORT; the server defaults to [::]:$PORT so public IPv4 and
# private-network IPv6 traffic share one listener. Do not set FMARCH_BIND here.
# Capacity defaults. Tune only from hosted measurements; keep queues bounded.
FMARCH_DB_MAX_CONNECTIONS=10
FMARCH_DB_ACQUIRE_TIMEOUT_MS=250
FMARCH_DB_STATEMENT_TIMEOUT_MS=5000
FMARCH_DB_LOCK_TIMEOUT_MS=1000
FMARCH_DB_IDLE_TRANSACTION_TIMEOUT_MS=10000
FMARCH_HTTP_MAX_IN_FLIGHT=128
FMARCH_HTTP_QUEUE_TIMEOUT_MS=50
FMARCH_HTTP_REQUEST_TIMEOUT_MS=15000
FMARCH_HTTP_RETRY_AFTER_SECONDS=1
FMARCH_WS_MAX_CONNECTIONS=512
FMARCH_WS_MAX_CONNECTIONS_PER_PRINCIPAL=4
FMARCH_PASSWORD_MAX_IN_FLIGHT=4
FMARCH_MEDIA_MAX_IN_FLIGHT=2
FMARCH_MEDIA_ACCOUNT_QUOTA_BYTES=268435456
FMARCH_OPERATOR_AUDIT_MAX_IN_FLIGHT=1
FMARCH_LIVE_PROJECTION_CAPACITY=256
# The image runs as UID 10001 and has no writable media volume; all media is shared object state.
# Optional hosted classic identity delivery transport. Set FMARCH_CLASSIC_AUTH=1
# only when all three variables below are configured with a real provider.
# FMARCH_IDENTITY_DELIVERY_ENDPOINT=https://provider.example.test/v1/deliveries
# FMARCH_IDENTITY_DELIVERY_PROVIDER_ID=http-json
# FMARCH_IDENTITY_DELIVERY_AUTH_TOKEN=${{IDENTITY_DELIVERY_AUTH_TOKEN}}
