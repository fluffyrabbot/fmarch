# Exact allowlist for the local, one-shot `fmarch-profile-index-admin` child.
#
# This is deliberately NOT a Railway service-variable template.  Do not create
# a `profile-index-admin` service and do not add any of these values to a
# shared/project variable set.  The canonical launcher is the short-lived
# Railway SSH database tunnel plus `railway run --service api`, followed by
# a fresh exact child environment; see docs/ops/profile-handle-index-rotation.md.
#
# The outer `railway run` process briefly receives the API environment solely
# to copy this exact allowlist into a fresh spawned child. It must never print,
# redirect, persist, or otherwise expose that outer environment. The child receives no
# `PG*`, Railway, media, event-key, authentication, migration, or key-admin
# authority.

# Rewrite an API URL that already uses exactly `sslmode=require` to the
# loopback `railway connect --ssh --tunnel-only` endpoint. Keep the
# `fmarch_application` credentials, database path, and require mode unchanged.
# This local tunnel procedure must not be used for `verify-ca` or
# `verify-full`: changing the hostname to loopback would defeat the original
# certificate-name verification rather than preserving it.
DATABASE_URL=<required-fmarch_application-url-rewritten-to-127.0.0.1-tunnel-port-with-sslmode=require>

# Current active profile-handle blind-index configuration. The KID is public;
# the key is opaque secret material of at least 32 bytes with no surrounding
# whitespace.
FMARCH_PROFILE_HANDLE_INDEX_KEY=<required-current-at-least-32-byte-opaque-secret>
FMARCH_PROFILE_HANDLE_INDEX_KID=staging-profile-index-current

# Replacement material is created in the protected local shell and delivered
# to this child once through stdin. It is never an API/Railway service variable
# and must differ from the active key.
FMARCH_PROFILE_HANDLE_INDEX_REPLACEMENT_KEY=<required-new-at-least-32-byte-opaque-secret>

# The profile claim authority is required to open and verify each active claim.
# These are copied from the API service's dedicated subject-authority custody,
# never from the media bucket. Staging uses HTTPS; do not set
# FMARCH_SUBJECT_AUTHORITY_ALLOW_HTTP.
FMARCH_SUBJECT_AUTHORITY_ENDPOINT=<required-subject-authority-endpoint>
FMARCH_SUBJECT_AUTHORITY_REGION=<required-subject-authority-region>
FMARCH_SUBJECT_AUTHORITY_BUCKET=<required-subject-authority-bucket>
FMARCH_SUBJECT_AUTHORITY_ACCESS_KEY_ID=<required-subject-authority-access-key>
FMARCH_SUBJECT_AUTHORITY_SECRET_ACCESS_KEY=<required-subject-authority-secret-key>
FMARCH_SUBJECT_AUTHORITY_URL_STYLE=virtual-host
FMARCH_SUBJECT_KEY_AUTHORITY_REVISION=staging-YYYY-MM-DD
FMARCH_SUBJECT_AUTHORITY_ID=<required-subject-authority-uuid>
FMARCH_SUBJECT_AUTHORITY_WRAP_KID=staging-wrap-YYYY-MM-DD
FMARCH_SUBJECT_AUTHORITY_WRAP_KEY=<required-subject-authority-wrap-key>
FMARCH_SUBJECT_AUTHORITY_JOURNAL_KID=staging-journal-YYYY-MM-DD
FMARCH_SUBJECT_AUTHORITY_JOURNAL_KEY=<required-subject-authority-journal-key>

# Never add DATABASE_MIGRATION_URL, DATABASE_KEY_ADMIN_URL,
# FMARCH_DATABASE_*_PASSWORD, FMARCH_AUTH_SOURCE_SIGNING_KEY,
# FMARCH_EVENT_*, AWS_*, WORKOS_*, FMARCH_SUBJECT_KEY_DIR, any PG* variable,
# or a Railway/project/service identifier to the spawned child.
