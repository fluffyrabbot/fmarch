# Protected operator-shell variables for the exact deployed image. These are
# not Railway API, frontend, or migrator service variables.
# Include exactly one sslmode=require, sslmode=verify-ca, or sslmode=verify-full;
# never allow the key-admin credential and runtime KEKs onto a downgrade path.
# Clear PG* connection variables; this URL is the sole connection authority.
DATABASE_KEY_ADMIN_URL=<required-postgresql-url-for-fmarch_key_admin-with-sslmode=require>
FMARCH_DATABASE_AUTHORITY_REVISION=staging-YYYY-MM-DD

# Runtime event-key custody required by fmarch-event-key-admin. Keep the prior
# key only for the bounded online migration; omit it for rehearsal/retirement.
FMARCH_EVENT_WRAP_KID=railway-wrap-v2
FMARCH_EVENT_WRAP_KEY=<required-canonical-padded-base64-32-byte-secret>
# FMARCH_EVENT_WRAP_KEYS=railway-wrap-v1=<prior-canonical-padded-base64-key>

# The secure configuration audit also requires the independent archive key.
FMARCH_EVENT_ARCHIVE_KID=railway-archive-v1
FMARCH_EVENT_ARCHIVE_KEY=<required-distinct-canonical-padded-base64-32-byte-secret>
# FMARCH_EVENT_ARCHIVE_KEYS=

FMARCH_DB_ACQUIRE_TIMEOUT_MS=250
FMARCH_DB_STATEMENT_TIMEOUT_MS=5000
FMARCH_DB_LOCK_TIMEOUT_MS=1000
FMARCH_DB_IDLE_TRANSACTION_TIMEOUT_MS=10000
RUST_LOG=info

# Never set DATABASE_URL or DATABASE_MIGRATION_URL in this shell. Destroy the
# shell/container after the bounded operation; keep DATABASE_KEY_ADMIN_URL out
# of every long-lived Railway service.
