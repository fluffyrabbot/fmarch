    "vite": "8.0.16"
  },
  "dependencies": {
    "@workos/authkit-sveltekit": "0.3.0",
    "cbor-x": "1.6.0"
  },
  "overrides": {
    "@sveltejs/kit": {
      "cookie": "0.7.2"
    }
